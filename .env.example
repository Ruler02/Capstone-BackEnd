# --- Aplikasi ---
APP_NAME=SIGAP BNPB
APP_ENV=development            # development | production
SECRET_KEY=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (dev pakai sqlite, produksi pakai Supabase/PostgreSQL) ---
DATABASE_URL=sqlite:///./sigap.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require

# --- Pipeline ---
ASR_BACKEND=fake               # fake | whisper
NER_BACKEND=fake               # fake | transformers
NER_MODEL_PATH=                # contoh: models/ner-indo-finetuned (kosong = default)
GEOCODER_BACKEND=fake          # fake | google
GOOGLE_MAPS_API_KEY=

# --- Notifikasi WhatsApp (fallback: pesan hanya dicatat ke log) ---
WHATSAPP_PROVIDER=log           # log | fonnte | wablas
WHATSAPP_API_KEY=

# --- Penyimpanan file ---
STORAGE_BACKEND=local          # local | supabase
MEDIA_ROOT=./media
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=media

# --- Frontend ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
